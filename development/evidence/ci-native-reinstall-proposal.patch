+            self.candidate['transaction_mode'] = mode
+            (self.folder / 'ubuntu-native-candidate.json').write_text(json.dumps(self.candidate))
+            self.downloads['candidate_record_sha256'] = m.sha(self.folder / 'ubuntu-native-candidate.json')
