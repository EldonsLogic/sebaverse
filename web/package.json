{
  "name": "@sebaverse/web",
  "version": "0.1.0",
  "private": true,
  "description": "Sebaverse Arabic-first local application shell; static React client with honest empty states",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "@tanstack/react-query": "5.107.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:demo": "vite --config vite.demo.config.mjs --mode demonstration",
    "check:demo-isolation": "node ../tools/demo/check-isolation.mjs"
  }
}
